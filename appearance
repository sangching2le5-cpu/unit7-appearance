            { id: 49, word: "first impressions", pos: "n pl", ipa: "/ˌfɜːst ɪmˈpreʃnz/", category: "General Appearance", vn: "ấn tượng đầu tiên", def: "the initial opinion formed about someone", ex: "First impressions are important in job interviews.", exVn: "Ấn tượng đầu tiên rất quan trọng trong các cuộc phỏng vấn xin việc.", icon: "🤝" }
        ];

        /* Nuance Challenge Data */
        const nuanceData = [
            {
                expl: "<b>slim vs skinny:</b> Both mean thin, but <b>slim</b> is positive/attractive ('thon thả'), while <b>skinny</b> is negative ('gầy giơ xương').",
                q: "Which word compliment someone for being pleasantly thin?",
                opts: ["skinny", "slim", "obese", "stout"],
                ans: "slim"
            },
            {
                expl: "<b>plump vs overweight vs obese:</b> <b>Plump</b> is a polite, pleasant word for slightly fat ('mập mạp'). <b>Overweight</b> is neutral/medical. <b>Obese</b> is a medical term for dangerously fat.",
                q: "What is a polite, gentle word to describe a soft, slightly fat baby or person?",
                opts: ["obese", "overweight", "plump", "skinny"],
                ans: "plump"
            },
            {
                expl: "<b>smart vs well-dressed vs elegant:</b> <b>Smart</b> means tidy and formal. <b>Well-dressed</b> means wearing good clothes. <b>Elegant</b> means graceful, stylish, and dignified.",
                q: "A person dressed in a graceful, sophisticated evening gown is best described as:",
                opts: ["scruffy", "elegant", "untidy-looking", "stout"],
                ans: "elegant"
            },
            {
                expl: "<b>Grammar Note:</b> Adjectives vs Noun phrases.<br><b>thin-faced</b> (adj) -> 'He is thin-faced.'<br><b>a thin face</b> (noun) -> 'He has a thin face.'",
                q: "Complete correctly: 'She is a ________ woman.'",
                opts: ["a round face", "round-faced", "round face", "face round"],
                ans: "round-faced"
            }
        ];

        /* STATE VARIABLES */
        let activeVocabList = [...vocabularyData];
        let currentCardIdx = 0;
        let favorites = JSON.parse(localStorage.getItem('unit7_favs') || '[]');
        let selectedMatchWord = null;
        let selectedMatchMeaning = null;
        let nuanceIdx = 0;
        let currentMode3Item = null;
        let currentMode4Item = null;
        let currentMode6Item = null;
        let detectiveTarget = null;

        /* INITIALIZATION */
        window.onload = function() {
            updateProgress();
            renderCard();
            initMatchGame();
            generateMode3();
            generateMode4();
            generateDetectiveCase();
            generateMode6();
            renderNuance();
            buildQuiz();
        };

        /* NAVIGATION & PROGRESS */
        function switchNav(viewId) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));

            document.getElementById(viewId + 'View').classList.add('active');
            event.currentTarget.classList.add('active');
        }

        function updateProgress() {
            const favRatio = (favorites.length / vocabularyData.length) * 100;
            const progress = Math.min(100, Math.round(favRatio + 20)); // baseline progress
            document.getElementById('globalProgressBar').style.width = progress + '%';
            document.getElementById('progressText').innerText = progress + '%';
            document.getElementById('favCount').innerText = favorites.length;
        }

        /* TEXT TO SPEECH */
        function speakWord(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-GB';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            } else {
                alert("Speech synthesis is not supported in this browser.");
            }
        }

        function speakCurrentWord() {
            const word = activeVocabList[currentCardIdx].word;
            speakWord(word);
        }

        /* ----------------------------------------------------
           MODE 1: LEARN (FLASHCARDS)
        ---------------------------------------------------- */
        function renderCard() {
            if (activeVocabList.length === 0) {
                document.getElementById('cardWord').innerText = "No items";
                document.getElementById('cardIpa').innerText = "";
                document.getElementById('cardVn').innerText = "";
                return;
            }

            const item = activeVocabList[currentCardIdx];
            document.getElementById('cardCategory').innerText = item.category;
            document.getElementById('cardIcon').innerText = item.icon;
            document.getElementById('cardWord').innerText = item.word;
            document.getElementById('cardIpa').innerText = item.ipa;
            document.getElementById('cardPos').innerText = item.pos;
            document.getElementById('cardVn').innerText = item.vn;
            document.getElementById('cardDef').innerText = item.def;
            document.getElementById('cardEx').innerText = `"${item.ex}"`;
            document.getElementById('cardExVn').innerText = `"${item.exVn}"`;

            document.getElementById('cardCounter').innerText = `Card ${currentCardIdx + 1} / ${activeVocabList.length}`;

            const isFav = favorites.includes(item.id);
            document.getElementById('favBtn').innerText = isFav ? "⭐" : "☆";
            document.getElementById('favBtn').style.color = isFav ? "#f59e0b" : "#64748b";
        }

        function nextCard() {
            if (currentCardIdx < activeVocabList.length - 1) {
                currentCardIdx++;
                renderCard();
            }
        }

        function prevCard() {
            if (currentCardIdx > 0) {
                currentCardIdx--;
                renderCard();
            }
        }

        function toggleMeaning() {
            const vnEl = document.getElementById('cardVn');
            vnEl.style.display = (vnEl.style.display === 'none') ? 'block' : 'none';
        }

        function toggleFavorite() {
            const item = activeVocabList[currentCardIdx];
            if (favorites.includes(item.id)) {
                favorites = favorites.filter(id => id !== item.id);
            } else {
                favorites.push(item.id);
            }
            localStorage.setItem('unit7_favs', JSON.stringify(favorites));
            updateProgress();
            renderCard();
        }

        function filterCategory() {
            const val = document.getElementById('categorySelect').value;
            if (val === 'ALL') {
                activeVocabList = [...vocabularyData];
            } else if (val === 'FAV') {
                activeVocabList = vocabularyData.filter(v => favorites.includes(v.id));
            } else {
                activeVocabList = vocabularyData.filter(v => v.category === val);
            }
            currentCardIdx = 0;
            renderCard();
        }

        /* ----------------------------------------------------
           PRACTICE MODES
        ---------------------------------------------------- */
        function switchPracticeMode(modeId) {
            document.querySelectorAll('.practice-submode').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.practice-tabs .tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById(modeId).style.display = 'block';
            event.currentTarget.classList.add('active');
        }

        /* MODE 2: MATCHING GAME */
        function initMatchGame() {
            const matchWords = document.getElementById('matchWords');
            const matchMeanings = document.getElementById('matchMeanings');
            matchWords.innerHTML = '';
            matchMeanings.innerHTML = '';

            const shuffled = [...vocabularyData].sort(() => 0.5 - Math.random()).slice(0, 5);
            const meaningsShuffled = [...shuffled].sort(() => 0.5 - Math.random());

            selectedMatchWord = null;
            selectedMatchMeaning = null;

            shuffled.forEach(item => {
                const card = document.createElement('div');
                card.className = 'match-card';
                card.dataset.id = item.id;
                card.innerText = item.word;
                card.onclick = () => selectMatchItem(card, 'word');
                matchWords.appendChild(card);
            });

            meaningsShuffled.forEach(item => {
                const card = document.createElement('div');
                card.className = 'match-card';
                card.dataset.id = item.id;
                card.innerText = item.vn;
                card.onclick = () => selectMatchItem(card, 'meaning');
                matchMeanings.appendChild(card);
            });
        }

        function selectMatchItem(card, type) {
            if (card.classList.contains('matched')) return;

            if (type === 'word') {
                document.querySelectorAll('#matchWords .match-card').forEach(c => c.classList.remove('selected'));
                card.classList.add('selected');
                selectedMatchWord = card;
            } else {
                document.querySelectorAll('#matchMeanings .match-card').forEach(c => c.classList.remove('selected'));
                card.classList.add('selected');
                selectedMatchMeaning = card;
            }

            if (selectedMatchWord && selectedMatchMeaning) {
                if (selectedMatchWord.dataset.id === selectedMatchMeaning.dataset.id) {
                    selectedMatchWord.classList.add('matched');
                    selectedMatchMeaning.classList.add('matched');
                    selectedMatchWord = null;
                    selectedMatchMeaning = null;
                } else {
                    alert("❌ Try again!");
                    selectedMatchWord.classList.remove('selected');
                    selectedMatchMeaning.classList.remove('selected');
                    selectedMatchWord = null;
                    selectedMatchMeaning = null;
                }
            }
        }

        /* MODE 3: CHOOSE THE CORRECT WORD */
        function generateMode3() {
            document.getElementById('mode3Feedback').innerText = '';
            currentMode3Item = vocabularyData[Math.floor(Math.random() * vocabularyData.length)];
            document.getElementById('mode3Question').innerText = `Definition: "${currentMode3Item.def}"`;

            let options = [currentMode3Item];
            while (options.length < 4) {
                let rand = vocabularyData[Math.floor(Math.random() * vocabularyData.length)];
                if (!options.find(o => o.id === rand.id)) options.push(rand);
            }
            options.sort(() => 0.5 - Math.random());

            const optsGrid = document.getElementById('mode3Options');
            optsGrid.innerHTML = '';
            options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerText = opt.word;
                btn.onclick = () => {
                    if (opt.id === currentMode3Item.id) {
                        btn.classList.add('correct');
                        document.getElementById('mode3Feedback').innerText = "✅ Correct!";
                        document.getElementById('mode3Feedback').style.color = "var(--success)";
                    } else {
                        btn.classList.add('wrong');
                        document.getElementById('mode3Feedback').innerText = `❌ Wrong! Correct answer: ${currentMode3Item.word}`;
                        document.getElementById('mode3Feedback').style.color = "var(--error)";
                    }
                };
                optsGrid.appendChild(btn);
            });
        }

        /* MODE 4: COMPLETE SENTENCE */
        function generateMode4() {
            document.getElementById('mode4Feedback').innerText = '';
            document.getElementById('mode4Input').value = '';
            currentMode4Item = vocabularyData[Math.floor(Math.random() * vocabularyData.length)];

            // Replace word in example sentence with blank
            const sentenceWithBlank = currentMode4Item.ex.replace(new RegExp(currentMode4Item.word, 'gi'), '__________');
            document.getElementById('mode4Sentence').innerHTML = `"${sentenceWithBlank}"<br><small style="color:var(--text-muted);">Vietnamese hint: ${currentMode4Item.vn}</small>`;
        }

        function checkMode4() {
            const input = document.getElementById('mode4Input').value.trim().toLowerCase();
            const target = currentMode4Item.word.toLowerCase();

            if (input === target) {
                document.getElementById('mode4Feedback').innerText = "✅ Correct!";
                document.getElementById('mode4Feedback').style.color = "var(--success)";
            } else {
                document.getElementById('mode4Feedback').innerText = `❌ Try again! Correct word: "${currentMode4Item.word}"`;
                document.getElementById('mode4Feedback').style.color = "var(--error)";
            }
        }

        /* MODE 5: APPEARANCE DETECTIVE */
        const detectiveCases = [
            {
                name: "Suspect A - Mark",
                img: "🧔‍♂️",
                desc: "Mark is 35 years old. His hair is disappearing at the front. He works out every day, wears neat suits to work, and has hair on his chin.",
                correct: ["receding hair", "muscular", "smart", "a beard"]
            },
            {
                name: "Suspect B - Emma",
                img: "👱‍♀️",
                desc: "Emma has pale yellow hair with loose waves. She has tiny brown spots on her face from the sun and is attractively thin.",
                correct: ["blonde", "freckles", "slim"]
            }
        ];

        function generateDetectiveCase() {
            document.getElementById('detectiveFeedback').innerText = '';
            detectiveTarget = detectiveCases[Math.floor(Math.random() * detectiveCases.length)];

            document.getElementById('detectiveProfile').innerHTML = `
                <div style="font-size:4rem;">${detectiveTarget.img}</div>
                <div>
                    <h4 style="color:var(--primary-dark); font-size:1.2rem;">${detectiveTarget.name}</h4>
                    <p style="margin-top:0.3rem;">${detectiveTarget.desc}</p>
                </div>
            `;

            const container = document.getElementById('detectiveCheckboxes');
            container.innerHTML = '';

            let allChoices = [...detectiveTarget.correct, "bald", "scruffy", "obese", "a crew-cut"];
            allChoices = [...new Set(allChoices)].sort(() => 0.5 - Math.random());

            allChoices.forEach(item => {
                const label = document.createElement('label');
                label.style.display = "flex";
                label.style.alignItems = "center";
                label.style.gap = "0.5rem";
                label.style.background = "#fff";
                label.style.padding = "0.5rem 0.8rem";
                label.style.borderRadius = "6px";
                label.style.border = "1px solid #cbd5e1";
                label.innerHTML = `<input type="checkbox" value="${item}"> ${item}`;
                container.appendChild(label);
            });
        }

        function checkDetective() {
            const checked = Array.from(document.querySelectorAll('#detectiveCheckboxes input:checked')).map(c => c.value);
            const isCorrect = detectiveTarget.correct.every(val => checked.includes(val)) && checked.length === detectiveTarget.correct.length;

            if (isCorrect) {
                document.getElementById('detectiveFeedback').innerText = "✅ Excellent Detective Work! You identified all correct traits!";
                document.getElementById('detectiveFeedback').style.color = "var(--success)";
            } else {
                document.getElementById('detectiveFeedback').innerText = `❌ Incorrect tags. Expected: ${detectiveTarget.correct.join(', ')}`;
                document.getElementById('detectiveFeedback').style.color = "var(--error)";
            }
        }

        /* MODE 6: WORD CATEGORIES */
        function generateMode6() {
            document.getElementById('mode6Feedback').innerText = '';
            currentMode6Item = vocabularyData[Math.floor(Math.random() * vocabularyData.length)];
            document.getElementById('mode6Word').innerText = currentMode6Item.word;
        }

        function checkMode6(cat) {
            let actualCategory = currentMode6Item.category;
            // standardizing height/build
            if (actualCategory === "Build" && (cat === "Height" || cat === "Build")) actualCategory = cat;

            if (currentMode6Item.category.includes(cat) || actualCategory === cat) {
                document.getElementById('mode6Feedback').innerText = `✅ Correct! "${currentMode6Item.word}" belongs to ${currentMode6Item.category}`;
                document.getElementById('mode6Feedback').style.color = "var(--success)";
                setTimeout(generateMode6, 1500);
            } else {
                document.getElementById('mode6Feedback').innerText = `❌ Try again! Correct category: ${currentMode6Item.category}`;
                document.getElementById('mode6Feedback').style.color = "var(--error)";
            }
        }

        /* MODE 7: NUANCE CHALLENGE */
        function renderNuance() {
            document.getElementById('nuanceFeedback').innerText = '';
            const item = nuanceData[nuanceIdx];
            document.getElementById('nuanceExpl').innerHTML = item.expl;
            document.getElementById('nuanceQuestion').innerText = item.q;

            const grid = document.getElementById('nuanceOptions');
            grid.innerHTML = '';

            item.opts.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerText = opt;
                btn.onclick = () => {
                    if (opt === item.ans) {
                        btn.classList.add('correct');
                        document.getElementById('nuanceFeedback').innerText = "✅ Correct!";
                        document.getElementById('nuanceFeedback').style.color = "var(--success)";
                    } else {
                        btn.classList.add('wrong');
                        document.getElementById('nuanceFeedback').innerText = `❌ Incorrect. The answer is ${item.ans}`;
                        document.getElementById('nuanceFeedback').style.color = "var(--error)";
                    }
                };
                grid.appendChild(btn);
            });
        }

        function nextNuance() {
            nuanceIdx = (nuanceIdx + 1) % nuanceData.length;
            renderNuance();
        }

        /* ----------------------------------------------------
           QUIZ ASSESSMENT SYSTEM (20 QUESTIONS)
        ---------------------------------------------------- */
        const quizQuestions = [
            { id: 1, type: "mcq", q: "1. What does 'receding hair' mean?", opts: ["Hair that is very thick", "Hair disappearing at the front of the head", "Hair dyed in bright red", "Curly hair"], ans: "Hair disappearing at the front of the head", expl: "Receding hair stops growing at the forehead line." },
            { id: 2, type: "mcq", q: "2. Which adjective describes someone attractively thin?", opts: ["skinny", "slim", "obese", "stout"], ans: "slim", expl: "'Slim' is positive ('thon thả'), while 'skinny' is negative ('gầy giơ xương')." },
            { id: 3, type: "fill", q: "3. Complete: She has cute small brown spots on her skin from the sun called ________.", ans: "freckles", expl: "Freckles are small brown spots on the skin." },
            { id: 4, type: "mcq", q: "4. What haircut is very short and often worn by men?", opts: ["a crew-cut", "long wavy hair", "auburn hair", "wrinkles"], ans: "a crew-cut", expl: "A crew-cut is a short male hairstyle." },
            { id: 5, type: "mcq", q: "5. 'Auburn hair' refers to what color?", opts: ["Dark blue", "Reddish-brown", "Pale yellow", "Pure white"], ans: "Reddish-brown", expl: "Auburn means reddish-brown hair." },
            { id: 6, type: "fill", q: "6. Fill in the missing word: 'He is thirtyish, meaning he is in his ________.'", ans: "thirties", expl: "Thirtyish means in his thirties (between 30 and 39)." },
            { id: 7, type: "mcq", q: "7. Which of the following is the opposite of 'well-dressed / smart'?", opts: ["elegant", "scruffy", "stunning", "handsome"], ans: "scruffy", expl: "Scruffy means untidy and dirty looking." },
            { id: 8, type: "mcq", q: "8. What happens to skin when it is severely burnt by sun?", opts: ["It becomes sunburnt", "It becomes stocky", "It becomes plump", "It becomes blonde"], ans: "It becomes sunburnt", expl: "Sunburnt refers to painful red skin from excessive sun exposure." },
            { id: 9, type: "mcq", q: "9. 'Plump' is a polite word for:", opts: ["Extremely thin", "Slightly fat in a soft pleasant way", "Very tall", "Muscular"], ans: "Slightly fat in a soft pleasant way", expl: "'Plump' politely describes a pleasantly soft figure." },
            { id: 10, type: "fill", q: "10. 'His hair is neither curly nor wavy; it is ________.'", ans: "straight", expl: "Straight hair is hair without curls or waves." },
            { id: 11, type: "mcq", q: "11. Choose the grammatically correct adjective: 'He is a ________ man.'", opts: ["round-faced", "a round face", "round face", "face round"], ans: "round-faced", expl: "'round-faced' is a hyphenated adjective." },
            { id: 12, type: "mcq", q: "12. What does the suffix '-ish' mean in 'tallish'?", opts: ["Very/extremely", "Somewhat / fairly", "Not at all", "Exactly"], ans: "Somewhat / fairly", expl: "-ish means approximately or somewhat." },
            { id: 13, type: "fill", q: "13. Complete: Healthy food gives you a clear facial skin, also known as a clear ________.", ans: "complexion", expl: "Complexion refers to the skin condition on the face." },
            { id: 14, type: "mcq", q: "14. 'Stunning' is closest in meaning to:", opts: ["unattractive", "extremely beautiful", "untidy", "skinny"], ans: "extremely beautiful", expl: "Stunning means remarkably beautiful." },
            { id: 15, type: "mcq", q: "15. Which word is used specifically to describe an attractive man?", opts: ["handsome", "a nice figure", "blonde", "plump"], ans: "handsome", expl: "'Handsome' is typically used for handsome men." },
            { id: 16, type: "fill", q: "16. Facial hair grown on the chin and cheeks of a man's face is a ________.", ans: "beard", expl: "A beard is facial hair on chin/cheeks." },
            { id: 17, type: "mcq", q: "17. 'Getting a tan' means:", opts: ["Losing weight", "Skin turning darker from sunlight", "Cutting hair short", "Getting old wrinkles"], ans: "Skin turning darker from sunlight", expl: "Getting a tan is darkening of the skin in the sun." },
            { id: 18, type: "fill", q: "18. A broad, strong person who is not very tall is described as ________.", ans: "stocky", expl: "Stocky means broad and solid build." },
            { id: 19, type: "mcq", q: "19. The initial opinion you form when meeting someone is called:", opts: ["first impressions", "personality", "feature", "complexion"], ans: "first impressions", expl: "First impressions are initial opinions formed." },
            { id: 20, type: "mcq", q: "20. 'Untidy-looking' is synonymous with:", opts: ["messy-looking", "smart", "elegant", "well-built"], ans: "messy-looking", expl: "Both mean disorderly or unkempt in appearance." }
        ];

        function buildQuiz() {
            const container = document.getElementById('quizQuestionsContainer');
            container.innerHTML = '';

            quizQuestions.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = 'quiz-question-card';

                if (item.type === 'mcq') {
                    let optsHtml = item.opts.map(o => `
                        <label style="display:block; margin:0.4rem 0; cursor:pointer;">
                            <input type="radio" name="q${idx}" value="${o}" required> ${o}
                        </label>
                    `).join('');
                    card.innerHTML = `<h4>${item.q}</h4>${optsHtml}`;
                } else {
                    card.innerHTML = `
                        <h4>${item.q}</h4>
                        <input type="text" class="quiz-input" name="q${idx}" required placeholder="Type answer...">
                    `;
                }
                container.appendChild(card);
            });
        }

        function submitQuiz(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            let score = 0;
            let breakdownHtml = '<h4 style="margin-bottom:1rem;">Detailed Breakdown:</h4>';

            quizQuestions.forEach((item, idx) => {
                const userAns = (formData.get(`q${idx}`) || '').trim();
                const isCorrect = userAns.toLowerCase() === item.ans.toLowerCase();

                if (isCorrect) score++;

                breakdownHtml += `
                    <div style="padding:1rem; border-radius:8px; margin-bottom:0.75rem; background: ${isCorrect ? 'var(--success-light)' : 'var(--error-light)'};">
                        <p style="font-weight:bold;">${item.q}</p>
                        <p>Your answer: <b>${userAns || 'None'}</b> ${isCorrect ? '✅' : '❌'}</p>
                        ${!isCorrect ? `<p>Correct answer: <b style="color:var(--success);">${item.ans}</b></p>` : ''}
                        <small style="color:var(--text-muted); display:block; margin-top:0.2rem;">Explanation: ${item.expl}</small>
                    </div>
                `;
            });

            const percent = Math.round((score / quizQuestions.length) * 100);
            document.getElementById('scoreCircle').innerText = `${score}/20`;
            document.getElementById('scorePercent').innerText = `${percent}% Correct`;

            let rating = "";
            if (percent >= 90) rating = "Excellent 🌟";
            else if (percent >= 80) rating = "Very Good 👍";
            else if (percent >= 70) rating = "Good 😊";
            else if (percent >= 60) rating = "Keep Practising 💪";
            else rating = "Review the vocabulary 📚";

            document.getElementById('scoreRating').innerText = rating;
            document.getElementById('quizForm').style.display = 'none';
            document.getElementById('quizResults').style.display = 'block';
            document.getElementById('quizBreakdown').innerHTML = breakdownHtml;
        }

        function restartQuiz() {
            document.getElementById('quizForm').reset();
            document.getElementById('quizForm').style.display = 'block';
            document.getElementById('quizResults').style.display = 'none';
        }

        /* ----------------------------------------------------
           CHARACTER DESCRIBER GENERATOR
        ---------------------------------------------------- */
        function generateDescriptionParagraph() {
            const hair = document.getElementById('descHair').value;
            const face = document.getElementById('descFace').value;
            const skin = document.getElementById('descSkin').value;
            const build = document.getElementById('descBuild').value;
            const general = document.getElementById('descGeneral').value;

            const paragraph = `This person is ${build}. They have ${hair} and ${face}. Their complexion features ${skin}. Overall, making a memorable first impression, they appear remarkably ${general}.`;

            document.getElementById('generatedParagraph').innerText = paragraph;
            document.getElementById('descResultBox').style.display = 'block';
        }

        function speakParagraph() {
            const text = document.getElementById('generatedParagraph').innerText;
            speakWord(text);
        }
    </script>
